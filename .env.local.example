# Copy this file to .env.local and fill in the key.
# .env.local is gitignored — never commit a real key.
#
# The AI layer talks to OpenRouter through its OpenAI-compatible API,
# so the official openai client works as-is. To use OpenAI direct
# instead, change OPENAI_BASE_URL to https://api.openai.com/v1 and
# drop the "openai/" prefix from the model name. Nothing else changes.
#
# For the deployed site, add the same variables in Vercel:
#   Project → Settings → Environment Variables
#
# Without the key set, the "Ask about my work" box degrades gracefully:
# it tells visitors to email instead. Nothing else on the site breaks.
# Check whether a deployment picked the key up at /api/health.

# Get a key at https://openrouter.ai/keys
OPENAI_API_KEY=

# Both optional — these are the defaults if you leave them unset.
# The model must support the chat completions API.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# ---------- Analytics (optional) ----------
# Umami. Leave the id unset and no tracker is injected at all, which is
# how local development and preview builds stay out of the numbers.
# Get the id from the Umami dashboard: Settings -> Websites -> your site.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Only needed if you self-host Umami. Defaults to the cloud host.
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Comma-separated hosts the tracker is allowed to report from. Set this in
# Vercel so that a local copy running with the id set does not pollute the
# production numbers. Leave it unset while verifying from localhost.
# NEXT_PUBLIC_UMAMI_DOMAINS=nidhipoojari.vercel.app
